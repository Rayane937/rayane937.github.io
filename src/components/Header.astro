---
/**
 * Header sticky : monogramme, navigation par ancres et CTA vers le CV.
 * Le menu mobile est un simple toggle vanilla (pas besoin d'île React ici).
 */
import { SITE } from '../data/site';

const links = [
  { href: '#a-propos', label: 'À propos' },
  { href: '#competences', label: 'Compétences' },
  { href: '#formation', label: 'Formation' },
  { href: '#projets', label: 'Projets' },
  { href: '#recommandations', label: 'Recommandations' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-night/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 sm:px-8">
    <!-- Monogramme / retour en haut de page -->
    <a href="#top" class="font-mono text-lg font-bold tracking-tight text-fog" aria-label="Retour en haut">
      rh<span class="text-brass">.</span>
    </a>

    <!-- Navigation desktop -->
    <nav aria-label="Navigation principale" class="hidden items-center gap-7 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="relative text-sm font-medium text-mist transition-colors after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-brass after:transition-transform after:duration-300 hover:text-fog hover:after:scale-x-100"
        >
          {link.label}
        </a>
      ))}
      <a
        href={SITE.cvPath}
        download
        class="rounded-md border border-brass/50 px-3.5 py-1.5 text-sm font-semibold text-brass transition-colors hover:bg-brass hover:text-night"
      >
        Mon CV
      </a>
    </nav>

    <!-- Bouton burger (mobile) -->
    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-md text-fog md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Ouvrir le menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path class="icone-ouvrir" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icone-fermer hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <!-- Menu mobile -->
  <nav id="menu-mobile" aria-label="Navigation mobile" class="hidden border-t border-line/60 px-5 pt-2 pb-4 md:hidden">
    {links.map((link) => (
      <a href={link.href} class="block py-2.5 text-base font-medium text-mist transition-colors hover:text-fog">
        {link.label}
      </a>
    ))}
    <a href={SITE.cvPath} download class="mt-2 inline-block rounded-md border border-brass/50 px-4 py-2 text-sm font-semibold text-brass">
      Télécharger mon CV
    </a>
  </nav>
</header>

<script>
  // Ouverture/fermeture du menu mobile, avec état ARIA tenu à jour.
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('menu-mobile')!;

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    toggle.querySelector('.icone-ouvrir')!.classList.toggle('hidden', open);
    toggle.querySelector('.icone-fermer')!.classList.toggle('hidden', !open);
  };

  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  // Referme le menu après un clic sur une ancre
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
