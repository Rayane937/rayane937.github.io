---
/**
 * Enveloppe réutilisable de section : ancre de navigation, numéro décoratif,
 * titre accessible et rythme vertical homogène sur toute la page.
 */
interface Props {
  /** Ancre de navigation (ex. "projets" → #projets) */
  id: string;
  /** Numéro affiché dans le kicker (ex. "02") */
  index: string;
  /** Libellé du kicker en petites capitales */
  kicker: string;
  /** Titre de la section (h2) */
  title: string;
  /** Fond alterné pour rythmer la page */
  alt?: boolean;
}

const { id, index, kicker, title, alt = false } = Astro.props;
---

<section id={id} class:list={['py-24 sm:py-32', alt && 'bg-night-soft']} aria-labelledby={`${id}-titre`}>
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <p class="mb-3 font-mono text-sm tracking-wide text-brass" aria-hidden="true">
      {index} — {kicker}
    </p>
    <h2 id={`${id}-titre`} class="mb-12 text-3xl font-bold tracking-tight text-fog sm:text-5xl">
      {title}
    </h2>
    <slot />
  </div>
</section>
