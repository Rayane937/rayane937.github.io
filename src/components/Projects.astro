---
/**
 * Section « Projets » : le rendu de la grille et le filtrage sont délégués
 * à l'île React ProjectsGrid (hydratée quand elle devient visible).
 */
import Section from './Section.astro';
import ProjectsGrid from './react/ProjectsGrid';
import { PROJECTS } from '../data/projects';
---

<Section id="projets" index="03" kicker="Projets" title="Ce que j’ai construit" alt>
  <ProjectsGrid projects={PROJECTS} client:visible />
</Section>
