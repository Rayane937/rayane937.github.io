---
/**
 * Bloc « Projets » : une section distincte par secteur d'intérêt
 * (Finance, Génie civil, Aéronautique, Informatique), toutes construites
 * sur le même composant SectorSection. L'ancre #projets englobe le tout.
 */
import SectorSection from './SectorSection.astro';
import { SECTORS } from '../data/projects';

// Numérotation des sections : 01 À propos, 02 Compétences, 03 → 06 secteurs
const premierIndex = 3;
---

<div id="projets" class="scroll-mt-20">
  {SECTORS.map((sector, i) => (
    <SectorSection sector={sector} index={String(premierIndex + i).padStart(2, '0')} alt={i % 2 === 0} />
  ))}
</div>
