---
/**
 * Section « À propos » : présentation courte + repères clés du parcours.
 */
import Section from './Section.astro';

const reperes = [
  { label: 'Formation', value: 'Polytech Paris-Saclay' },
  { label: 'Spécialité', value: 'Informatique & Ingénierie Mathématique' },
  { label: 'Expériences', value: 'Thales · HGH Infrared Systems' },
  { label: 'Localisation', value: 'Île-de-France' },
];
---

<Section id="a-propos" index="01" kicker="À propos" title="Un profil polyvalent, curieux par nature" alt>
  <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr]">
    <div class="space-y-5 text-lg leading-relaxed text-mist">
      <p>
        Je suis ingénieur logiciel, diplômé de Polytech Paris-Saclay en informatique et
        ingénierie mathématique. Ce qui me motive n’a pas changé depuis ma première ligne de
        code : <strong class="font-semibold text-fog">comprendre comment les choses
        fonctionnent, puis construire — et fiabiliser — quelque chose d’utile</strong>.
      </p>
      <p>
        J’ai forgé ce profil en <strong class="font-semibold text-fog">environnement industriel
        exigeant</strong> : chez <strong class="font-semibold text-fog">Thales</strong> (affaire
        Rafale), sur la migration d’une plateforme logicielle servant de socle à des projets
        aéronautiques et de défense, avec diagnostic et résolution d’anomalies complexes ; chez
        <strong class="font-semibold text-fog">HGH Infrared Systems</strong>, sur un logiciel de
        calibration pour la thermographie industrielle, de la migration C++ → C# jusqu’aux phases
        de test menées en autonomie.
      </p>
      <p>
        J’accorde une attention particulière à la
        <strong class="font-semibold text-fog">vérification, la validation et les tests</strong>
        (dont l’automatisation avec Robot Framework) : un logiciel n’a de valeur que s’il est
        fiable. Polyvalent, je suis rapidement opérationnel sur une nouvelle stack et choisis
        l’outil adapté au problème plutôt que l’inverse.
      </p>
    </div>

    <!-- Repères clés, en liste de définitions pour la sémantique -->
    <dl class="h-fit divide-y divide-line rounded-lg border border-line bg-card">
      {reperes.map((r) => (
        <div class="flex flex-col gap-1 px-5 py-4">
          <dt class="font-mono text-xs tracking-wide text-brass uppercase">{r.label}</dt>
          <dd class="font-medium text-fog">{r.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
