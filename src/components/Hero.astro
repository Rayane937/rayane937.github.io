---
/**
 * Section d'accueil : accroche, titre, portrait et CTA vers le CV et les projets.
 * Mise en page deux colonnes (texte / photo) sur grand écran ; apparition en
 * cascade des éléments (classes .reveal, animées par l'observateur du Layout).
 */
import { SITE } from '../data/site';
---

<section id="top" class="relative overflow-hidden">
  <!-- Dégradés neutres très discrets en arrière-plan -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(ellipse 60% 50% at 85% -5%, rgba(0, 0, 0, 0.05), transparent 60%),
      radial-gradient(ellipse 50% 45% at 0% 100%, rgba(0, 0, 0, 0.03), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.5fr_1fr] lg:gap-16"
  >
    <!-- Colonne texte -->
    <div class="order-2 lg:order-1">
      <p class="reveal mb-6 font-mono text-sm tracking-wide text-brass" data-delay="1">
        Développement logiciel · Informatique industrielle · Vérification &amp; validation
      </p>

      <h1 class="reveal text-5xl font-extrabold tracking-tight text-fog sm:text-7xl" data-delay="2">
        {SITE.name}<span class="text-brass">.</span>
        <span class="mt-4 block text-mist">{SITE.role}</span>
      </h1>

      <p class="reveal mt-8 max-w-xl text-lg leading-relaxed text-mist sm:text-xl" data-delay="3">
        Diplômé de Polytech Paris-Saclay en informatique et ingénierie mathématique, je conçois,
        fais évoluer et fiabilise des logiciels en environnement industriel exigeant — du
        développement à la vérification, la validation et les tests. J’aime comprendre un système
        en profondeur pour le rendre robuste et maintenable.
      </p>

      <div class="reveal mt-10 flex flex-wrap items-center gap-4" data-delay="4">
        <a
          href={SITE.cvPath}
          download
          class="inline-flex items-center gap-2 rounded-md bg-brass px-5 py-3 font-semibold text-night transition-all duration-300 hover:-translate-y-0.5 hover:bg-brass-bright hover:shadow-lg hover:shadow-black/10"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M4 21h16"></path>
          </svg>
          Télécharger mon CV
        </a>
        <a
          href="#projets"
          class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 font-semibold text-fog transition-all duration-300 hover:-translate-y-0.5 hover:border-brass/60 hover:text-brass"
        >
          Voir mes projets
        </a>
      </div>
    </div>

    <!-- Colonne portrait -->
    <div class="reveal order-1 mx-auto w-full max-w-[18rem] lg:order-2 lg:max-w-none" data-delay="2">
      <div class="relative">
        <!-- Halo doux derrière la photo -->
        <div
          class="pointer-events-none absolute -inset-5 -z-10 rounded-[2.5rem] bg-gradient-to-tr from-line/70 via-line/30 to-transparent blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div class="float-slow overflow-hidden rounded-[2rem] border border-line bg-card shadow-xl shadow-black/5">
          <img
            src={SITE.photo}
            alt={`Portrait de ${SITE.name}`}
            width="705"
            height="880"
            loading="eager"
            decoding="async"
            class="aspect-[4/5] w-full object-cover object-[50%_42%]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
