---
/**
 * Section d'accueil : accroche, titre cible, CTA vers le CV et les projets.
 */
import { SITE } from '../data/site';
---

<section id="top" class="relative overflow-hidden">
  <!-- Halo décoratif en arrière-plan (purement visuel) -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(ellipse 70% 55% at 75% 0%, rgba(233, 180, 92, 0.09), transparent 65%),
      radial-gradient(ellipse 55% 45% at 15% 100%, rgba(34, 48, 73, 0.5), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-col justify-center px-5 py-24 sm:px-8 sm:py-36">
    <p class="mb-5 font-mono text-sm text-brass">
      Diplômé en septembre 2026
    </p>

    <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-fog sm:text-6xl">
      {SITE.name}<span class="text-brass">.</span>
      <span class="mt-3 block text-mist">{SITE.role}</span>
    </h1>

    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-mist">
      Ingénieur de formation, je recherche un poste dans la finance, le génie civil ou
      l’aéronautique. Mes compétences informatiques ne sont pas mon métier cible : ce sont
      mon atout différenciant — analyser, modéliser et automatiser au service du métier.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={SITE.cvPath}
        download
        class="inline-flex items-center gap-2 rounded-md bg-brass px-5 py-3 font-semibold text-night transition-colors hover:bg-brass-bright"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M4 21h16"></path>
        </svg>
        Télécharger mon CV
      </a>
      <a
        href="#projets"
        class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 font-semibold text-fog transition-colors hover:border-brass/60 hover:text-brass"
      >
        Voir mes projets
      </a>
    </div>
  </div>
</section>
